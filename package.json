    "undici": "6.29.1",
    "serialize-javascript": "7.0.5",
    "immutable@npm:^4.0.0-rc.12": "4.3.9",
    "minimatch@npm:^10.0.3": "10.2.3",
    "ws@npm:8.17.1": "8.21.0",
    "ws@npm:~8.17.1": "8.21.0",
    "ws@npm:8.18.3": "8.21.0",
    "picomatch@npm:^4.0.2": "4.0.4",
